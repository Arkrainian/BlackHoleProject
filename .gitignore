# Build output (build.bat), including FetchContent'd third-party
# sources/build trees (glfw, glm, imgui, glew)
build/
build_cuda/

# MSI installer output (build_installer.bat); rebuild from installer/Product.wxs
installer/*.msi
installer/*.wixpdb

# Crash dumps and runtime logs
crashdumps/
*.log

# ImGui window-layout state, regenerated on first run
imgui.ini

# Claude Code machine-local settings (permissions etc., not shared config)
.claude/settings.local.json

# Common IDE/editor and Windows cruft
.vs/
.vscode/
*.user
Thumbs.db

# Local scratch folder, not part of the project
newlines/
